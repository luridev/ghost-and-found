{
  "name": "ghost-and-found",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost & Found browser game",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "check:commit": "npm run lint && npm run typecheck",
    "dev": "vite",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:eslint": "eslint . --cache --cache-strategy metadata --concurrency auto",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:stylelint -- --fix",
    "lint:stylelint": "stylelint \"**/*.{css,vue}\" --cache --cache-strategy metadata",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "validate": "npm run check:commit"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@protoapps/browser-targets": "^0.1.0",
    "@protoapps/eslint-config-vue": "^0.1.1",
    "@protoapps/stylelint-config": "^0.1.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "lefthook@2.2.2": true
  }
}
